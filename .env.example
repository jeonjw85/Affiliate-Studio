# 이 파일을 .env로 복사한 뒤 값 입력, 변경 후 앱 재시작
# 공백·#·$가 있는 값은 작은따옴표 사용: WP_APP_PASSWORD='abcd efgh ijkl'

# NAS 접속: 실제 NAS IP/호스트명 추가 (URL·포트 없이 쉼표로 구분)
# 예: STUDIO_ALLOWED_HOSTS=192.168.1.20,nas.local
STUDIO_ALLOWED_HOSTS=127.0.0.1,localhost
STUDIO_PORT=8787
# 직접 실행의 바인딩 주소, Docker는 컨테이너 내부에서 0.0.0.0 사용
STUDIO_HOST=127.0.0.1

# local: Ollama/llama.cpp, api: OpenAI 호환 HTTPS API
AI_MODE=local
# AI_MODEL을 비워두면 AI 미설정 상태로 기본 기능 사용 가능
AI_MODEL=
# local 예: qwen3:4b-instruct-2507-q4_K_M
# api 예: gpt-4.1-mini (사용 서비스의 JSON Schema 지원 모델)
AI_BASE_URL=
# local 직접 실행: http://127.0.0.1:11434/v1
# local Docker Ollama: http://ollama:11434/v1
# local 호스트의 Ollama: http://host.docker.internal:11434/v1
# api: https://api.openai.com/v1 또는 사용 서비스의 호환 API 기본 주소
AI_API_KEY=
AI_LOCAL_HOSTS=ollama,host.docker.internal
AI_TIMEOUT_SECONDS=180
AI_DAILY_LIMIT=10
# 로컬 AI 긴 글 문맥, 자동 운영은 16384 권장 (메모리 여유 필요)
OLLAMA_CONTEXT_LENGTH=4096

# WordPress: 세 값을 모두 설정하면 연결 사용 가능
WP_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# 제휴 링크 자동 발급 (선택)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
TOSS_ACCESS_KEY=
TOSS_SECRET_KEY=
TOSS_PUBLISHER_ID=

# AI 본문 이미지 생성 (선택): OpenAI 호환 이미지 API
# IMAGE_MODE를 비우면 이미지 생성 없이 상품 대표 이미지만 사용
IMAGE_MODE=
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_API_KEY=
IMAGE_DAILY_LIMIT=3

# Telegram 자동 운영 (선택): BotFather 봇 토큰, 내 개인 대화 chat ID, 내 사용자 ID
# 다른 사람의 메시지는 처리하지 않음. 세 값을 모두 설정해야 수신을 시작
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
